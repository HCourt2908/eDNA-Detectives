  comparisonRules:
  - threatId: warming
    speciesId: shark
    observationOptions:
    - evidenceId: E01_SHARK_NONDETECTION
      resolutions:
      - judgement: 0
        outcome: 2
        feedback: A depth shift needs evidence from different depths; this observation
          does not directly match it.
      - judgement: 1
        outcome: 1
        feedback: 'Accepted with a caveat: repeated all-depth non-detection challenges
          a simple depth-shift prediction.'
      - judgement: 2
        outcome: 2
        feedback: This repeated, high-quality observation directly tests the predicted
          shark pattern. Decide whether it matches or challenges a depth shift.
    - evidenceId: E04_BENTHIC_STABLE
      resolutions:
      - judgement: 0
        outcome: 2
        feedback: This observation may be part of the wider food web, but it does
          not directly match or contradict this species prediction.
      - judgement: 1
        outcome: 2
        feedback: This observation may be part of the wider food web, but it does
