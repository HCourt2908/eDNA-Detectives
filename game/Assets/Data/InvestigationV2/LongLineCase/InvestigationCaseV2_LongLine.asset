  m_Script: {fileID: 11500000, guid: 25dec598121ca4c87b650810d23b07be, type: 3}
  m_Name: InvestigationCaseV2_LongLine
  m_EditorClassIdentifier: EDNA.Investigation.V2.Domain::EDNA.Investigation.V2.Domain.InvestigationV2CaseDefinition
  caseId: investigation_v2_longline_01
  displayName: The Missing Predator
  briefing: A modern eDNA survey shows a repeated shark non-detection, tuna at more
    sites, and repeated krill non-detection. Compare overlapping ecosystem models
    before writing a report.
  species:
  - {fileID: 11400000, guid: 42c221d64c5d6458dba439c97f2be05d, type: 2}
  - {fileID: 11400000, guid: 03f540c5eefc349cb8b6060d611964bb, type: 2}
  - {fileID: 11400000, guid: c69ff8bc758a0499eaf111ef0c36f3cf, type: 2}
  - {fileID: 11400000, guid: 3d32f21ed0cfb45d6aa5f209b9e12f9b, type: 2}
  - {fileID: 11400000, guid: d62c0750f16ec419986917dbbdf8dc25, type: 2}
  observations:
  - evidenceId: E01_SHARK_NONDETECTION
    displayName: Shark repeatedly not detected
    detail: Shark DNA was not detected in several high-quality samples across the
      surveyed depths.
    relatedSpeciesId: shark
    source: 0
    unlockStage: 0
    unlockThreatId: 
    confidence: 2
    claimType: 1
    category: 1
    confidenceReason: Repeated high-quality non-detection is stronger than one sample,
      but it still does not prove absence.
  - evidenceId: E02_TUNA_WIDER_DETECTION
    displayName: Tuna detected at more sites
    detail: Tuna DNA was detected across more survey locations than in the historical
      baseline.
    relatedSpeciesId: tuna
    source: 0
    unlockStage: 0
    unlockThreatId: 
    confidence: 1
    claimType: 2
    category: 1
    confidenceReason: Wider detection is consistent with expansion but does not directly
      measure abundance.
  - evidenceId: E03_KRILL_NONDETECTION
    displayName: Krill repeatedly not detected
    detail: Krill DNA was not detected in several high-quality samples where it was
      historically expected.
    relatedSpeciesId: krill
    source: 0
    unlockStage: 0
    unlockThreatId: 
    confidence: 2
    claimType: 1
    category: 1
    confidenceReason: The pattern supports a decline hypothesis but does not prove
      a population count.
  - evidenceId: E04_BENTHIC_STABLE
    displayName: Sea star remains stable
    detail: The benthic indicator was repeatedly detected at its historical deep
      sites.
    relatedSpeciesId: sea_star
    source: 0
    unlockStage: 0
    unlockThreatId: 
    confidence: 1
    claimType: 4
    category: 2
    confidenceReason: Repeated detection across the same sites supports stability,
      pending ROV confirmation of habitat condition.
  - evidenceId: E05_TEMPERATURE_NORMAL
    displayName: Temperature remains in the historical range
    detail: The multi-depth CTD profile remains within the historical range and no
      coherent depth-shift pattern appears.
    relatedSpeciesId: shark
    source: 1
    unlockStage: 1
    unlockThreatId: warming
    confidence: 1
    claimType: 5
    category: 4
    confidenceReason: A normal profile challenges warming but cannot rule it out
      alone.
  - evidenceId: E06_PLASTIC_INDICATOR_STABLE
    displayName: Filter-feeding mussel remains stable
    detail: The plastic-sensitive reference species remains detected at its historical
      sites.
    relatedSpeciesId: mussel
    source: 0
    unlockStage: 0
    unlockThreatId: 
    confidence: 1
    claimType: 4
    category: 5
    confidenceReason: This challenges a broad plastic-impact pattern but cannot rule
      it out alone.
  - evidenceId: E07_FISHING_LINE
    displayName: Fishing line recorded near shark habitat
    detail: ROV footage shows fishing line near the area where sharks were historically
      recorded.
    relatedSpeciesId: shark
    source: 2
    unlockStage: 2
    unlockThreatId: 
    confidence: 2
    claimType: 6
    category: 3
    confidenceReason: A physical gear observation confirms an already-developed long-line
      hypothesis.
  - evidenceId: E08_SEAFLOOR_INTACT
    displayName: Seafloor remains intact
    detail: ROV footage shows no obvious trawl marks or broad habitat damage.
    relatedSpeciesId: sea_star
    source: 2
    unlockStage: 2
    unlockThreatId: 
    confidence: 2
    claimType: 6
    category: 3
    confidenceReason: The intact habitat strongly challenges bottom trawling alongside
      the stable benthic eDNA pattern.
  - evidenceId: L01_NONDETECTION_LIMITATION
    displayName: Not detected does not mean gone
    detail: eDNA non-detection does not prove complete absence; sampling and detection
      limits remain.
    relatedSpeciesId: 
    source: 3
    unlockStage: 3
    unlockThreatId: 
    confidence: 2
    claimType: 7
    category: 0
    confidenceReason: This scientific limitation is always available in the final
      report.
