  m_Script: {fileID: 11500000, guid: c821e5d1dc86e4dc58708131c0c48e53, type: 3}
  m_Name: Threat_ToxicAlgalBloom
  m_EditorClassIdentifier: EDNA.Investigation.Domain::EDNA.Investigation.Domain.ThreatSimulationDefinition
  threatId: toxic_algal_bloom
  displayName: Toxic algal bloom
  summary: 'Extreme trial: the five model species disappear locally. This
    is an authored comparison, not a universal outcome of algal blooms.'
  icon: {fileID: 21300000, guid: 95d83ee2788a4b97872eb6b45b2f1d2c, type: 3}
  glyphKind: 4
  speciesPredictions:
  - speciesId: shark
    predictedState: 5
    rationale: This extreme trial assumes local loss of sharks after a severe bloom.
  - speciesId: tuna
    predictedState: 5
    rationale: This extreme trial assumes local loss of tuna after a severe bloom.
  - speciesId: atlantic_herring
    predictedState: 5
    rationale: This extreme trial assumes local loss of herring. Our survey instead
      recorded more herring.
  - speciesId: krill
    predictedState: 5
    rationale: This extreme trial assumes local loss of krill; our survey instead
      recorded more krill.
  - speciesId: phytoplankton
    predictedState: 5
    rationale: The assumed loss refers to our representative species, Prochlorococcus
      marinus, not all phytoplankton or the bloom-forming algae.
  - speciesId: tree_bubblegum_coral
    predictedState: 4
    rationale: A coral response has not been supplied for this extreme trial.
  useFoodWebCascade: 0
  optionalExploration: 1
  displaySpeciesIds:
  - shark
  - tuna
  - atlantic_herring
  - krill
  - phytoplankton
  foodSupplyLinks: []
