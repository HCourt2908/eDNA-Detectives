  minimumObserveDiscoveries: 5
  requiredComparedThreatIds:
  - longline
  - bottom_trawling
  requiredComparisonSpecies:
  - threatId: longline
    requiredComparisonSpeciesIds:
    - sea_star
  - threatId: bottom_trawling
    requiredComparisonSpeciesIds:
    - sea_star
  requiredComparisonsPerThreat: 2
  minimumCompletedComparisons: 7
  correctThreatId: longline
  confirmationEvidenceIds:
  - E07_FISHING_LINE
  - E08_SEAFLOOR_INTACT
  minimumReportEvidence: 4
  evidenceCategoryRequirements:
  - category: 1
    minimumCount: 2
  - category: 2
    minimumCount: 1
  - category: 3
    minimumCount: 1
  minimumConfirmationEvidenceInReport: 1
  minimumReportLimitations: 1
  requiredReasoningId: food_web_cascade
  reasoningOptions:
  - reasoningId: food_web_cascade
    displayName: "Fewer sharks \u2192 more tuna \u2192 fewer krill"
    explanation: Removing the predator lets tuna expand, increasing predation on
      krill.
  - reasoningId: shared_habitat_shift
    displayName: All three species moved when their habitat shifted
    explanation: A shared habitat shift would need a coherent environmental or depth
      pattern.
  - reasoningId: direct_fishing_loss
    displayName: Fishing directly removed sharks, tuna, and krill
    explanation: Selective long-line fishing does not directly remove every level
      of this food web.
  limitations:
  - limitationId: L01_NONDETECTION_LIMITATION
    displayName: Not detected does not mean gone
    explanation: eDNA non-detection does not prove complete absence.
  - limitationId: L02_SURVEY_COVERAGE
    displayName: Only three sites were surveyed
    explanation: The survey did not cover every place or time.
  successFeedback: "Case solved. Long-line fishing best explains the shared shark\u2013tuna\u2013krill
    cascade, while stable benthic eDNA and an intact seafloor challenge bottom trawling.
    The fishing line confirms the best-supported explanation without turning eDNA
    non-detection into proof of absence."
