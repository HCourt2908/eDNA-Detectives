  observations:
  - evidenceId: E01_SHARK_NONDETECTION
    displayName: Shark repeatedly not detected
    detail: 'Illustrative survey record: Shark repeatedly not detected compared with
      the historical example. This is an authored learning scenario, not a field
      measurement.'
    relatedSpeciesId: shark
    source: 0
    unlockStage: 0
    unlockThreatId:
    confidence: 2
    claimType: 1
    category: 1
