  m_Script: {fileID: 11500000, guid: c821e5d1dc86e4dc58708131c0c48e53, type: 3}
  m_Name: Threat_BottomTrawling
  m_EditorClassIdentifier: EDNA.Investigation.Domain::EDNA.Investigation.Domain.ThreatSimulationDefinition
  threatId: bottom_trawling
  displayName: Bottom trawling
  summary: 'Best-fitting model for this case: targeted tuna and shark bycatch decline,
    herring increases, seabed coral is lost, and surface phytoplankton stays stable.'
  icon: {fileID: 21300000, guid: 96abde5153d644294879228d46d96b2a, type: 3}
  glyphKind: 3
  speciesPredictions:
  - speciesId: shark
    predictedState: 1
    rationale: Hammerheads decrease through bycatch in this scenario.
  - speciesId: tuna
    predictedState: 1
    rationale: Tuna decreases because it is targeted by the trawling scenario.
  - speciesId: atlantic_herring
    predictedState: 0
    rationale: This scenario assumes reduced predation allows a herring population
      boom, despite the loss of coral-spawn food.
  - speciesId: krill
    predictedState: 4
    rationale: Krill is not included in this trawling food-supply model.
  - speciesId: phytoplankton
    predictedState: 2
    rationale: Surface phytoplankton remains unaffected; dead organic material still
      sinks.
  - speciesId: tree_bubblegum_coral
    predictedState: 5
    rationale: The scenario assumes seabed damage removes coral. This is a prediction
      of habitat loss.
  useFoodWebCascade: 0
  optionalExploration: 0
  displaySpeciesIds:
  - shark
  - tuna
  - atlantic_herring
  - tree_bubblegum_coral
  - phytoplankton
  foodSupplyLinks:
  - sourceSpeciesId: phytoplankton
